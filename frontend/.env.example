# Aarogya Bindu frontend — example environment configuration.
# Copy to `.env.local` for local development. Never commit real secrets.

# Base URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Aarogya AI report assistant (SERVER-SIDE ONLY) ---------------------------
# These are read only by app/api/assistant (Node.js). They must NEVER use the
# NEXT_PUBLIC_ prefix, which would expose them to the browser bundle.

# Cline API key (https://app.cline.bot). Placeholder — put the real value in
# .env.local only. Usage is billed to your Cline account credits.
CLINE_API_KEY=
# "cline" = live Cline provider via the Cline SDK.
# "fake"  = deterministic offline test responder (no network, no key, no AI).
ASSISTANT_PROVIDER_ID=cline
# Cline model ID. When empty (or the key is empty) the assistant shows an
# "unavailable" state; the rest of the app is unaffected.
ASSISTANT_MODEL_ID=anthropic/claude-haiku-4.5
# Provider timeout in milliseconds (1000–60000).
ASSISTANT_TIMEOUT_MS=30000
# FastAPI URL as seen from the Next.js server (defaults to NEXT_PUBLIC_API_BASE_URL).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
