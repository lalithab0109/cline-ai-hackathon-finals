# Aarogya Bindu backend — example environment configuration.
# Copy to `.env` and adjust for your local setup. Never commit real secrets.

# Comma-separated list of origins allowed to call the API (CORS).
# The Next.js dev server runs on http://localhost:3000 by default.
ALLOWED_ORIGINS=http://localhost:3000

# Host/port for local development (used by run scripts / documentation).
HOST=127.0.0.1
PORT=8000
